PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/trusthire

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (for evidence file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SendGrid SMTP or Gmail)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=your_sendgrid_api_key
EMAIL_FROM=noreply@trusthire.in

# Frontend URL (for CORS + email links)
CLIENT_URL=http://localhost:5173

# MCA/GST API (Government of India)
# MCA21 company master data API — public, no key needed for basic lookup
MCA_API_BASE=https://www.mca.gov.in/mcafoportal/getCompanyMasterData.do
# GST verification (use any free GST lookup service or official API)
GST_API_BASE=https://sheet.gstincheck.co.in/check
GST_API_KEY=your_gst_api_key
